# Example Configuration for llm-cli
# Save this to ~/.config/llm_cli/config.toml

[general]
unified_default_provider = "google"
LLM_PROMPT_HISTORY = "~/.config/llm_cli/history.log"
LLM_CHAT_LOG = "~/.config/llm_cli/chat.log"
max_chat_log_lines = 10000

# Audit log for tool execution (especially execute_command)
LLM_AUDIT_LOG = "~/.local/state/llm_cli/audit.log"
max_audit_log_lines = 5000

[google]
api_key = "YOUR_GEMINI_API_KEY"
system_prompt = "You are a helpful assistant."
[google.models]
default = "gemini-flash-latest"
lite = "gemini-flash-lite-late"
flash = "gemini-flash-latest"
pro = "gemini-pro-latest"

[openai]
api_key = "YOUR_OPENAI_API_KEY"
[openai.models]
default = "gpt-5.2"
nano = "gpt-5-nano"
mini = "gpt-5-mini"

[anthropic]
api_key = "YOUR_CLAUDE_API_KEY"
[anthropic.models]
default = "claude-sonnet-4-5-20250929"
haiku = "claude-haiku-4-5-20250929"
sonnet = "claude-sonnet-4-5-20250929"
opus = "claude-opus-4-5-20250929"

[xai]
api_key = "YOUR_GROK_API_KEY"
[xai.models]
default = "grok-4-1-fast-non-reasoning"
reasoning = "grok-4-1-fast-reasoning"

[ollama]
api_url = "http://localhost:11434/v1/chat/completions"
# By default, Ollama client connects to http://localhost:11434/v1/chat/completions
# You can override this by setting api_url to your local endpoint.
[ollama.models]
default = "gemma3:270m"
gemma = "gemma3:12b"
gemma-nano = "gemma3:128m"
gemma-tiny = "gemma3:1b"
gemma-small = "gemma3:4b"
phi4 = "phi4-mini:3.8b"

# Security settings for command execution guardrails
[security]
# Additional commands to allow beyond the default whitelist
# Default whitelist includes: ls, cat, grep, git, python, etc.
# See llm_cli/security/command_validator.py for the full default list
allowed_commands = [
    # Add any custom commands you want to allow here
    # Example: "custom_script", "special_tool"
]

# Additional commands allowed for MCP server spawning
# Default MCP whitelist: node, python, python3, deno, npx, docker, ssh, uvx
allowed_mcp_commands = [
    # Add any custom MCP server commands here
    # Example: "custom_mcp_server"
]

# WARNING: Setting this to true disables protection against shell injection
# Only enable if you fully understand the security implications
allow_dangerous_patterns = false
